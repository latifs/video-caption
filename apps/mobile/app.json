{
  "expo": {
    "name": "video-caption-app",
    "slug": "video-caption-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "video-caption-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.videocaptionapp.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to select videos for captioning."
      }
    },
    "android": {
      "package": "com.videocaptionapp.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
